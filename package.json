{
  "name": "ts-js-slug-skill",
  "version": "2.0.0",
  "description": "Agent skill for clear, consistent TypeScript and JavaScript identifier naming using a configurable abbreviation dictionary.",
  "type": "module",
  "bin": {
    "ts-js-slug-skill": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "assets/ts-js-slug-skill-logo.svg",
    "assets/ts-js-slug-skill-icon.svg"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run verify && npm run build",
    "publish:npm": "npm publish --access public --registry=https://registry.npmjs.org",
    "publish:dry-run": "npm run publish:npm -- --dry-run"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent-skills",
    "skill",
    "typescript",
    "javascript",
    "naming",
    "abbreviation",
    "slug"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aShu-guo/ts-js-slug-skill.git"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.4",
    "ts-morph": "^23.0.0",
    "tsup": "^8.2.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=18"
  }
}
